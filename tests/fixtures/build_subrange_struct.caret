struct Pair { first: i32, second: i32 }
fn main() -> i32 {
    var data = [
        Pair { first: 0, second: 0 },
        Pair { first: 0, second: 0 },
        Pair { first: 0, second: 0 }
    ];
    let view = data[1..3];
    view[0] = Pair { first: 20, second: 0 };
    view[1] = Pair { first: 0, second: 22 };
    return data[1].first + data[2].second;
}
